model SupplierCategory {
  id             String     @id @default(uuid()) @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  name           String     @db.VarChar(120)
  normalizedName String     @map("normalized_name") @db.VarChar(120)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  suppliers      Supplier[]

  @@unique([companyId, normalizedName])
  @@index([companyId, active])
  @@map("supplier_categories")
}

model SupplierTag {
  id             String                  @id @default(uuid()) @db.Uuid
  companyId      String                  @map("company_id") @db.Uuid
  name           String                  @db.VarChar(120)
  normalizedName String                  @map("normalized_name") @db.VarChar(120)
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  suppliers      SupplierTagAssignment[]

  @@unique([companyId, normalizedName])
  @@index([companyId, active])
  @@map("supplier_tags")
}

model Supplier {
  id                     String                  @id @default(uuid()) @db.Uuid
  companyId              String                  @map("company_id") @db.Uuid
  supplierCode           String                  @map("supplier_code") @db.VarChar(24)
  createRequestKey       String?                 @map("create_request_key") @db.VarChar(100)
  supplierType           String                  @map("supplier_type") @db.VarChar(20)
  legalName              String                  @map("legal_name") @db.VarChar(180)
  normalizedName         String                  @map("normalized_name") @db.VarChar(180)
  tradeName              String?                 @map("trade_name") @db.VarChar(180)
  normalizedTradeName    String?                 @map("normalized_trade_name") @db.VarChar(180)
  primaryPhone           String?                 @map("primary_phone") @db.VarChar(20)
  secondaryPhone         String?                 @map("secondary_phone") @db.VarChar(20)
  whatsappPhone          String?                 @map("whatsapp_phone") @db.VarChar(20)
  email                  String?                 @db.VarChar(254)
  website                String?                 @db.VarChar(300)
  nationalId             String?                 @map("national_id") @db.VarChar(40)
  taxNumber              String?                 @map("tax_number") @db.VarChar(40)
  commercialRegistration String?                 @map("commercial_registration") @db.VarChar(80)
  categoryId             String?                 @map("category_id") @db.Uuid
  notes                  String?                 @db.Text
  status                 String                  @default("ACTIVE") @db.VarChar(20)
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  category               SupplierCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  addresses              SupplierAddress[]
  contacts               SupplierContact[]
  tags                   SupplierTagAssignment[]

  @@unique([companyId, supplierCode])
  @@unique([companyId, createRequestKey])
  @@unique([companyId, nationalId])
  @@unique([companyId, taxNumber])
  @@unique([companyId, commercialRegistration])
  @@index([companyId, status, updatedAt])
  @@index([companyId, normalizedName])
  @@index([companyId, primaryPhone])
  @@index([companyId, whatsappPhone])
  @@index([companyId, email])
  @@index([categoryId])
  @@map("suppliers")
}

model SupplierAddress {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  label       String?  @db.VarChar(80)
  governorate String?  @db.VarChar(120)
  city        String?  @db.VarChar(120)
  street      String?  @db.VarChar(180)
  details     String?  @db.VarChar(600)
  landmark    String?  @db.VarChar(180)
  phone       String?  @db.VarChar(20)
  isDefault   Boolean  @default(false) @map("is_default")
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, active])
  @@index([governorate, city])
  @@map("supplier_addresses")
}

model SupplierContact {
  id            String   @id @default(uuid()) @db.Uuid
  supplierId    String   @map("supplier_id") @db.Uuid
  name          String   @db.VarChar(180)
  jobTitle      String?  @map("job_title") @db.VarChar(120)
  phone         String?  @db.VarChar(20)
  whatsappPhone String?  @map("whatsapp_phone") @db.VarChar(20)
  email         String?  @db.VarChar(254)
  isPrimary     Boolean  @default(false) @map("is_primary")
  active        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, active])
  @@index([supplierId, name])
  @@index([phone])
  @@index([email])
  @@map("supplier_contacts")
}

model SupplierTagAssignment {
  id         String      @id @default(uuid()) @db.Uuid
  supplierId String      @map("supplier_id") @db.Uuid
  tagId      String      @map("tag_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tag        SupplierTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([supplierId, tagId])
  @@index([tagId])
  @@map("supplier_tag_assignments")
}
