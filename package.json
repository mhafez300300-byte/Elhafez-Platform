{
  "name": "@elhafez/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Elhafez Platform Core - approved modular monolith baseline",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema ./prisma",
    "db:migrate": "prisma migrate deploy --schema ./prisma",
    "db:status": "prisma migrate status --schema ./prisma",
    "db:seed": "tsx prisma/seed/seed.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run modules packages --exclude '**/*.integration.spec.ts'",
    "test:architecture": "node scripts/check-architecture.mjs && vitest run tests/architecture",
    "test:integration": "vitest run tests/integration",
    "test:transaction": "vitest run tests/integration/transaction-rollback.integration.spec.ts",
    "test:auth": "vitest run tests/integration/authentication.integration.spec.ts",
    "test:permission-scope": "vitest run tests/integration/permission-scope-regression.integration.spec.ts",
    "build:api": "rm -rf dist/api && tsc -p tsconfig.build.api.json && tsc-alias -p tsconfig.build.api.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "pnpm build:api && pnpm build:web",
    "start:api": "node dist/api/apps/api/src/main.js",
    "create:module": "node scripts/create-module.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.2",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.2",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.19.0",
    "prisma": "6.19.3",
    "supertest": "7.0.0",
    "tsc-alias": "1.8.10",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.22.0",
    "vite": "6.1.0",
    "vitest": "3.0.5",
    "@nestjs/testing": "11.1.28"
  }
}
